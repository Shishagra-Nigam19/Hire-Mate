# ===================================================================
# HireMate Production Environment Variables Template
# Copy this file to .env on the EC2 instance and fill in production secrets
# ===================================================================

# Server & Profile Config
SPRING_PROFILES_ACTIVE=prod
PORT=8080

# PostgreSQL Database Settings
POSTGRES_DB=hiremate_db
POSTGRES_USER=postgres_user
POSTGRES_PASSWORD=SuperSecretPassword123!
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/hiremate_db

# Security & JWT Secrets (Minimum 256-bit secret key)
JWT_SECRET=9a6e2c8f1a4b7d3e5f8c9b2a1d4e7f3c6a9b8c7d6e5f4a3b2c1d0e9f8a7b6c5d4e3f2a1b0c9d8e7f6a5b4c3d2e1f0
JWT_EXPIRATION_MS=900000
JWT_REFRESH_EXPIRATION_MS=604800000

# AWS S3 Storage Credentials
AWS_REGION=us-east-1
AWS_S3_BUCKET=hiremate-resumes-prod
AWS_ACCESS_KEY_ID=AKIAIOSFODNN7EXAMPLE
AWS_SECRET_ACCESS_KEY=wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY

# Production CORS Allowed Origins
ALLOWED_ORIGINS=https://hiremate.com,https://www.hiremate.com

# SMTP / Email Settings
SPRING_MAIL_HOST=smtp.sendgrid.net
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=apikey
SPRING_MAIL_PASSWORD=SG.secret_key_here
MAIL_FROM_EMAIL=no-reply@hiremate.com
MAIL_SENDER_NAME=HireMate Recruitment Platform

# Rate Limiting Configuration
RATE_LIMIT_AUTH_CAPACITY=5
RATE_LIMIT_API_CAPACITY=100
